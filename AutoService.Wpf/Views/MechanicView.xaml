<UserControl x:Class="AutoService.Wpf.Views.MechanicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:car3d="clr-namespace:AutoService.Wpf.Car3D"
             Loaded="MechanicView_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: заказ и слои -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Заказ:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="OrderCombo" Width="440" Height="40" FontSize="15" Margin="0,0,20,0"
                      VerticalContentAlignment="Center" SelectionChanged="OrderCombo_SelectionChanged"/>
            <Button x:Name="BodyButton" Content="Кузов (внешний слой)" Width="230" Height="44"
                    FontSize="15" FontWeight="Bold" Margin="0,0,8,0" Click="BodyLayer_Click"/>
            <Button x:Name="InnerButton" Content="Узлы и детали (внутренний слой)" Width="290" Height="44"
                    FontSize="15" FontWeight="Bold" Click="InnerLayer_Click"/>
        </WrapPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- 3D-модель и кнопки видов -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="#C5CAD1" BorderThickness="1">
                    <car3d:CarViewer3D x:Name="Viewer3D"/>
                </Border>
                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button Content="3/4" Width="90" Height="40" Margin="0,0,8,0" FontSize="14" Click="ViewThreeQuarter_Click"/>
                    <Button Content="Спереди" Width="100" Height="40" Margin="0,0,8,0" FontSize="14" Click="ViewFront_Click"/>
                    <Button Content="Сзади" Width="100" Height="40" Margin="0,0,8,0" FontSize="14" Click="ViewRear_Click"/>
                    <Button Content="Слева" Width="100" Height="40" Margin="0,0,8,0" FontSize="14" Click="ViewLeft_Click"/>
                    <Button Content="Справа" Width="100" Height="40" Margin="0,0,8,0" FontSize="14" Click="ViewRight_Click"/>
                    <Button Content="Сверху" Width="100" Height="40" FontSize="14" Click="ViewTop_Click"/>
                </WrapPanel>
            </Grid>

            <!-- Правая панель: состояние детали, комментарий, замечания -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,0,0,0">
                    <TextBlock x:Name="ZoneText" Text="Нажмите на деталь автомобиля" FontSize="18"
                               FontWeight="Bold" TextWrapping="Wrap" MinHeight="64" Margin="0,0,0,10"/>

                    <Button Content="Исправно" Background="#4CAF50" Foreground="White" Height="54"
                            FontSize="17" FontWeight="Bold" Margin="0,0,0,8" Click="StateOk_Click"/>
                    <Button Content="Требует внимания" Background="#FFC107" Foreground="Black" Height="54"
                            FontSize="17" FontWeight="Bold" Margin="0,0,0,8" Click="StateWarning_Click"/>
                    <Button Content="Неисправно" Background="#E53935" Foreground="White" Height="54"
                            FontSize="17" FontWeight="Bold" Margin="0,0,0,8" Click="StateCritical_Click"/>
                    <Button Content="Сбросить отметку" Background="#C8CDD2" Height="42"
                            FontSize="14" Click="StateReset_Click"/>

                    <TextBlock Text="Комментарий механика:" Margin="0,16,0,4" FontWeight="Bold"/>
                    <TextBox x:Name="CommentBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                    <Button Content="Сохранить комментарий" Height="42" FontSize="14" Margin="0,8,0,0"
                            Click="SaveComment_Click"/>

                    <TextBlock Text="Найденные замечания:" Margin="0,16,0,4" FontWeight="Bold"/>
                    <ListBox x:Name="DefectsList" Height="190"/>

                    <TextBlock Text="Вращение: правая кнопка мыши. Масштаб: колесо мыши. Быстрые виды: кнопки под моделью."
                               Foreground="#666666" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>