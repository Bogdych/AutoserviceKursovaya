<UserControl x:Class="AutoService.Wpf.Views.EstimateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Заказ:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="OrderCombo" Width="520" Height="38" FontSize="14"
                      VerticalContentAlignment="Center" SelectionChanged="OrderCombo_SelectionChanged"/>
        </WrapPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="410"/>
            </Grid.ColumnDefinitions>

            <!-- Строки сметы -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Тип" Binding="{Binding KindText}" Width="100"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="90"/>
                        <DataGridTextColumn Header="Цена, $" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Сумма, $" Binding="{Binding Sum, StringFormat=N2}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="1" Content="Удалить выбранную строку" HorizontalAlignment="Left"
                        Padding="14,6" Margin="0,8,0,0" Click="DeleteLine_Click"/>
            </Grid>

            <!-- Правая панель -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,0,0,0">

                    <GroupBox Header="Замечания диагностики" Padding="6" Margin="0,0,0,8">
                        <ListBox x:Name="DefectsList" Height="110"/>
                    </GroupBox>

                    <GroupBox Header="Добавить запчасть" Padding="6" Margin="0,0,0,8">
                        <StackPanel>
                            <ComboBox x:Name="PartCombo" Height="32" VerticalContentAlignment="Center"/>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="QtyBox" Text="1" Width="60" Height="30" Margin="0,0,10,0"/>
                                <Button Content="Добавить" Padding="14,5" Click="AddPart_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Добавить работу" Padding="6" Margin="0,0,0,8">
                        <StackPanel>
                            <ComboBox x:Name="OperationCombo" Height="32" VerticalContentAlignment="Center"/>
                            <Button Content="Добавить" Padding="14,5" Margin="0,6,0,0"
                                    HorizontalAlignment="Left" Click="AddOperation_Click"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Дополнительная услуга" Padding="6" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBox x:Name="ServiceNameBox" Height="30"/>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="Стоимость, $:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="ServicePriceBox" Width="80" Height="30" Margin="0,0,10,0"/>
                                <Button Content="Добавить" Padding="14,5" Click="AddService_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Скидка" Padding="6" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBox x:Name="DiscountBox" Width="70" Height="30" Margin="0,0,6,0"/>
                            <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="Применить" Padding="14,5" Click="ApplyDiscount_Click"/>
                        </WrapPanel>
                    </GroupBox>

                    <GroupBox Header="Итого" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Запчасти" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PartsTotalText" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="Работы" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="WorksTotalText" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="Дополнительные услуги" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ServicesTotalText" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="Скидка" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DiscountText" Margin="0,2"/>

                            <TextBlock Grid.Row="4" Text="К ОПЛАТЕ" FontSize="20" FontWeight="Bold" Margin="0,10,0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TotalText" FontSize="20"
                                       FontWeight="Bold" Margin="0,10,0,2"/>

                            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                <TextBlock x:Name="HoursText" FontWeight="Bold"/>
                                <TextBlock Text="Срок считается из расчёта 8 нормо-часов в день, без учёта загрузки мастера."
                                           Foreground="#666666" TextWrapping="Wrap" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>