<UserControl x:Class="AutoService.Wpf.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <WrapPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="ФИО"/>
                    <TextBox x:Name="NameBox" Width="260" Height="30"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Телефон"/>
                    <TextBox x:Name="PhoneBox" Width="170" Height="30"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Марка"/>
                    <TextBox x:Name="BrandBox" Width="130" Height="30"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Модель"/>
                    <TextBox x:Name="ModelBox" Width="130" Height="30"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,8">
                    <TextBlock Text="Госномер"/>
                    <TextBox x:Name="PlateBox" Width="120" Height="30"/>
                </StackPanel>
            </WrapPanel>
            <WrapPanel>
                <Button Content="Принять клиента" Click="AddClient_Click" Padding="14,6" Margin="0,0,10,0"/>
                <Button Content="Добавить авто выбранному клиенту" Click="AddCar_Click" Padding="14,6"/>
            </WrapPanel>
        </StackPanel>

        <DataGrid x:Name="ClientsGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="170"/>
                <DataGridTextColumn Header="Автомобили" Binding="{Binding Cars}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>