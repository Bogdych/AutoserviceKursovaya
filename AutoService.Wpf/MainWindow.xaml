<Window x:Class="AutoService.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AutoService.Wpf.Views"
        Title="Автосервис"
        WindowState="Maximized"
        MinWidth="900" MinHeight="600"
        FontSize="14">
    <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
        <TabItem Header="Клиенты">
            <views:ClientsView x:Name="ClientsPage"/>
        </TabItem>
        <TabItem Header="Менеджер">
            <views:ManagerView x:Name="ManagerPage"/>
        </TabItem>
    </TabControl>
</Window>